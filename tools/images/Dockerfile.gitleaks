# gitleaks, as secret-scan.yml runs it: one image, named by tag and digest. Dependabot moves both (the docker
# entry for /tools/images in .github/dependabot.yml). Nothing is built from this file: tools/image-ref.sh reads the
# FROM line. The gitleaks rev in both pre-commit configs is the same release (a test fails otherwise).
FROM ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
