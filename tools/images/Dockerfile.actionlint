# actionlint, as actionlint.yml runs it: one image, named by tag and digest. Dependabot moves both (the docker
# entry for /tools/images in .github/dependabot.yml). Nothing is built from this file: tools/image-ref.sh reads the
# FROM line. The actionlint rev in both pre-commit configs is the same release (a test fails otherwise).
FROM rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
