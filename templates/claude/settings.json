{
  "permissions": {
    "deny": [
      "Bash(git stash)",
      "Bash(git stash -*)",
      "Bash(git stash push *)",
      "Bash(git stash save *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push * master)",
      "Bash(git push *:master)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git reset --hard origin/*)",
      "Bash(git reset --soft origin/*)",
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/guard.py"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
